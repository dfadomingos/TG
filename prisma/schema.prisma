generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  celular           String
  senha             String
  aceitou_termos    Boolean  @default(false)
  receber_novidades Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  favoritos         Evento[] @relation("UserFavorites")
}

model Organizador {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  celular         String
  senha           String
  nome_produtora  String
  cnpj            String   @unique
  link_social     String?
  aceitou_termos  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  eventos_criados Evento[] @relation("OrganizerToEvent")
}

model Evento {
  id           String      @id @default(cuid())
  titulo       String
  descricao    String
  categoria    String
  data_horario DateTime
  status       EventStatus @default(PUBLISHED)
  destaque     Boolean     @default(false)
  views        Int         @default(0)
  endereco     String
  numero       String?
  bairro       String
  cidade       String      @default("Franca")
  estado       String      @default("SP")
  cep          String?
  preco        Float       @default(0)
  link_compra  String?
  imagem       String
  organizerId  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  organizer    Organizador @relation("OrganizerToEvent", fields: [organizerId], references: [id])
  favoritedBy  Usuario[]   @relation("UserFavorites")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}
