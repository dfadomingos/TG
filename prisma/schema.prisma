generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  celular           String
  senha             String
  aceitou_termos    Boolean  @default(false)
  receber_novidades Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  favoritos         Favorito[]
}

model Organizador {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  celular         String
  senha           String
  nome_produtora  String
  cnpj            String   @unique
  link_social     String?
  aceitou_termos  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  eventos_criados Evento[]
  favoritos       Favorito[]
}

model Evento {
  id           String      @id @default(cuid())
  titulo       String
  descricao    String      @db.Text
  categoria    CategoriaEvento
  data_horario DateTime
  status       EventStatus @default(Publicado)
  destaque     Boolean     @default(false)
  views        Int         @default(0)
  //endereço
  endereco     String
  numero       String?
  bairro       String?
  complemento  String?
  cidade       String      @default("Franca")
  estado       String      @default("SP")
  cep          String?
  //ingressos
  preco        Float       @default(0)
  link_compra  String?
  imagem       String
  //relacionamentos
  organizerId  String  
  organizer    Organizador @relation(fields: [organizerId], references: [id])
  //favoritos
  favoritedBy  Favorito[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  //indices para otimização de busca
  @@index([data_horario])
  @@index([categoria])
}

model Favorito {
  id            String       @id @default(cuid())
  usuarioId     String?
  organizadorId String?
  eventoId      String
  createdAt     DateTime     @default(now()) // quando foi favoritado
  //relacionamentos
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizador   Organizador? @relation(fields: [organizadorId], references: [id], onDelete: Cascade)
  evento        Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId]) // impede que o mesmo usuário favorite o mesmo evento 2x
  @@unique([organizadorId, eventoId]) // impede que o mesmo organizador favorite o mesmo evento 2x
}

enum EventStatus {
  Cancelado
  Rascunho
  Publicado
  Finalizado
}

enum CategoriaEvento {
  Show
  Gastronomia
  Esporte
  Teatro
  Palestra
  Workshop
  Exposicao
  Outros
}
